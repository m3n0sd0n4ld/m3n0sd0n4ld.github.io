---
layout: null
permalink: /search.json
---
[
  {% for post in site.posts %}
    {% assign img_src = post.image %}
    {% if img_src == nil or img_src == "" %}
      {% assign img_test = post.content | split: 'src="' %}
      {% if img_test.size > 1 %}
        {% assign img_src = img_test[1] | split: '"' | first %}
      {% else %}
        {% assign img_test = post.content | split: '![' %}
        {% if img_test.size > 1 %}
          {% assign img_src = img_test[1] | split: '](' | last | split: ')' | first %}
        {% endif %}
      {% endif %}
    {% endif %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "date": {{ post.date | date: "%d %b %Y" | jsonify }},
      "tags": {{ post.tags | join: ", " | jsonify }},
      "image": {{ img_src | jsonify }},
      "content": {{ post.content | strip_html | strip_newlines | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]